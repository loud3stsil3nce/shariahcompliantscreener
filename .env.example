# Database Connection
# Option A: Local macOS Homebrew PostgreSQL (Default port 5432)
DATABASE_URL=postgresql+asyncpg://rafiurrahman@localhost:5432/db_screener

# Option B: Zenbook Server Aegis PostgreSQL (via Tailscale port 5433)
# DATABASE_URL=postgresql+asyncpg://shariah_screener_app:your_screener_db_password@100.115.220.54:5433/db_screener

# AI Segment Auditor & LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional Rate-Limit Behavior (fail-fast to OpenAI fallback on 429)
FALLBACK_ON_RATE_LIMIT=true

# Service Ports
API_PORT=8001
UI_PORT=3000
